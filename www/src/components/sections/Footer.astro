---
---

<footer class="py-20 text-center">
  <div class="section-divider mb-16"></div>
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="font-heading text-2xl text-noir-50 mb-3">Open source. MIT licensed.</h2>
    <p class="text-noir-500 text-sm mb-8">Star on GitHub and help make codebases safer.</p>
    <a
      href="https://github.com/peaktwilight/foxguard"
      target="_blank"
      rel="noopener"
      class="btn-primary no-underline hover:no-underline"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      Star on GitHub
    </a>

    <div class="mt-12 rounded-2xl border border-noir-800 bg-noir-900/95 p-6 text-left">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-noir-600 mb-2">Contact</div>
          <h3 class="font-heading text-xl text-noir-50 mb-2">Send a note without leaving the site</h3>
          <p class="max-w-lg text-sm leading-relaxed text-noir-500">
            Questions about the scanner, rule coverage, or rollout plans. This form posts to a Cloudflare Pages Function and sends server-side email.
          </p>
        </div>
        <div class="hidden sm:flex items-center rounded-full bg-noir-950 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-noir-500">
          foxguard.dev
        </div>
      </div>

      <form id="contact-form" class="grid gap-3">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-noir-600">Name</span>
            <input
              name="name"
              type="text"
              required
              maxlength="120"
              class="rounded-xl border border-noir-800 bg-noir-950 px-4 py-3 text-sm text-noir-200 outline-none transition-colors placeholder:text-noir-600 focus:border-noir-600"
              placeholder="Your name"
            />
          </label>

          <label class="grid gap-1.5">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-noir-600">Email</span>
            <input
              name="email"
              type="email"
              required
              maxlength="320"
              class="rounded-xl border border-noir-800 bg-noir-950 px-4 py-3 text-sm text-noir-200 outline-none transition-colors placeholder:text-noir-600 focus:border-noir-600"
              placeholder="you@company.com"
            />
          </label>
        </div>

        <label class="grid gap-1.5">
          <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-noir-600">Message</span>
          <textarea
            name="message"
            required
            rows="6"
            maxlength="5000"
            class="resize-y rounded-2xl border border-noir-800 bg-noir-950 px-4 py-3 text-sm leading-relaxed text-noir-200 outline-none transition-colors placeholder:text-noir-600 focus:border-noir-600"
            placeholder="What are you trying to solve?"
          ></textarea>
        </label>

        <input name="website" type="text" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p id="contact-status" class="text-sm text-noir-500">
            Replies go to the email address you enter above.
          </p>

          <button
            id="contact-submit"
            type="submit"
            class="inline-flex items-center justify-center rounded-xl bg-fox px-4 py-2.5 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-noir-950 transition-colors hover:bg-fox-light"
          >
            Send message
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="section-divider mt-16 mb-8"></div>
  <div class="text-[11px] text-noir-600 font-mono flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
    <span>MIT</span>
    <span class="opacity-40">·</span>
    <a href="https://github.com/peaktwilight" class="text-noir-500 hover:text-fox transition-colors no-underline">Peak Twilight</a>
    <span class="opacity-40">·</span>
    <a href="/blog" class="text-noir-500 hover:text-fox transition-colors no-underline">Blog</a>
    <span class="opacity-40">·</span>
    <a href="https://marketplace.visualstudio.com/items?itemName=peaktwilight.foxguard" class="text-noir-500 hover:text-fox transition-colors no-underline">VS Code</a>
    <span class="opacity-40">·</span>
    <a href="https://www.npmjs.com/package/foxguard" class="text-noir-500 hover:text-fox transition-colors no-underline">npm</a>
    <span class="opacity-40">·</span>
    <a href="https://crates.io/crates/foxguard" class="text-noir-500 hover:text-fox transition-colors no-underline">crates.io</a>
  </div>
</footer>
